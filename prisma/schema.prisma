generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model AiConversation {
  id        String   @id
  query     String
  response  String
  createdAt DateTime @default(now())
}

model BlogPost {
  id        String   @id
  slug      String   @unique
  title     String
  content   String
  tags      String[]
  category  String   @default("")
  summary   String   @default("")
  published Boolean  @default(false)
  date      DateTime @default(now())
  createdAt DateTime @default(now())
  updatedAt DateTime
}

model LifeRecord {
  id        String   @id
  content   String
  images    String[]
  location  String?
  mood      String?
  createdAt DateTime @default(now())
}

model Project {
  id          String   @id
  slug        String   @unique
  title       String
  description String   @default("")
  content     String   @default("")
  tech        String[] @default([])
  github      String   @default("")
  demo        String   @default("")
  year        String   @default("")
  groupText   String   @default("其他") @map("group")
  icon        String   @default("")
  published   Boolean  @default(false)
  attachments String   @default("[]")
  createdAt   DateTime @default(now())
  updatedAt   DateTime
}

model Upload {
  id        String   @id
  key       String   @unique
  url       String
  size      Int
  mimeType  String
  createdAt DateTime @default(now())
}

model User {
  id        String   @id
  email     String   @unique
  password  String
  createdAt DateTime @default(now())
}
